# AAPDASETU Environment Configuration
# Local SQLite database (replace with postgresql://user:pass@host:5432/db for production)
DATABASE_URL="file:./dev.db"

# Secret key for JWT sessions (Citizens, Responders, Administrators)
JWT_SECRET="aapdasetu-emergency-secret-key-2026-super-secure"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Mode toggle: When true, clearly labels simulated geometries and demo data
NEXT_PUBLIC_DEMO_MODE="true"

# Optional External Integrations (Fallback deterministic engine active if omitted)
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="..."
# CWC_FLOOD_API_KEY="..."
# MAPBOX_TOKEN="..."

